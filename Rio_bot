bot.on('message', async (ctx) => {
    const userId = ctx.from.id;
    const text = ctx.message.text;

    if (!text || text.startsWith('/')) return;

    if (isAdmin(userId) && text.startsWith('📢')) {
        const message = text.replace('📢', '').trim();
        if (message) {
            await broadcastMessage(ctx, message);
        }
        return;
    }

    const isSubscribed = await checkSubscription(userId);
    if (!isSubscribed) {
        return ctx.replyWithHTML(
            '⚠️ <b>للوصول إلى هذه الخدمة، يجب عليك الاشتراك في قناتنا أولاً!</b>\n\n' +
            '📌 <b>رابط القناة:</b>\n' +
            '<a href="' + CHANNEL_URL + '">' + CHANNEL_URL + '</a>\n\n' +
            '🔔 <b>بعد الاشتراك، أعد إرسال طلبك.</b>'
        );
    }

    if (!waClient) {
        return ctx.reply('⏳ البوت قيد التجهيز، حاول بعد شوي');
    }

    const now = Date.now();
    const cooldownData = userCooldowns.get(userId);

    if (cooldownData && now < cooldownData.endTime) {
        const remaining = Math.ceil((cooldownData.endTime - now) / 1000);
        return ctx.replyWithHTML(
            '⏳ <b>أنت في فترة انتظار!</b>\n\n' +
            '⏱️ تبقت ' + remaining + ' ثانية للفحص مرة أخرى.\n' +
            '📌 <b>انتظر حتى انتهاء الوقت ثم أرسل أرقاماً جديدة.</b>'
        );
    }

    const lines = text.split('\n').map(line => line.trim()).filter(line => line.length > 0);
    const numbers = [];
    const originalNumbers = [];

    for (let line of lines) {
        let cleanNumber = line.replace(/^\+/, '').replace(/^00/, '');
        if (/^\d+$/.test(cleanNumber)) {
            numbers.push(cleanNumber);
            if (line.startsWith('+')) {
                originalNumbers.push('+' + cleanNumber);
            } else {
                originalNumbers.push('+' + cleanNumber);
            }
        }
    }

    if (numbers.length === 0) {
        return ctx.replyWithHTML(
            '📱 <b>أرسل لي أرقام فقط</b>\n\n' +
            'مثال: <code>966501234567</code> أو <code>+966501234567</code>\n' +
            'كل رقم في سطر منفصل'
        );
    }

    const MAX_CHECK = 100;
    let totalNumbers = numbers.length;
    let numbersToCheck = numbers.slice(0, MAX_CHECK);
    let originalToCheck = originalNumbers.slice(0, MAX_CHECK);

    let waitTime = 0;
    let waitMessage = '';

    if (totalNumbers === 1) {
        waitTime = 5000;
        waitMessage = '✅ <b>تم فحص رقم واحد</b>\n⏳ يمكنك الفحص مرة أخرى بعد 5 ثواني';
        userCooldowns.set(userId, { endTime: now + waitTime });
    } else if (totalNumbers >= 2 && totalNumbers <= 10) {
        waitTime = 5000;
        waitMessage = '✅ <b>تم فحص ' + totalNumbers + ' أرقام</b>\n⏳ يمكنك الفحص مرة أخرى بعد 5 ثواني';
        userCooldowns.set(userId, { endTime: now + waitTime });
    } else if (totalNumbers >= 11 && totalNumbers <= 100) {
        waitTime = 10000;
        waitMessage = '✅ <b>تم فحص ' + totalNumbers + ' رقم</b>\n⏳ يمكنك الفحص مرة أخرى بعد 10 ثواني';
        userCooldowns.set(userId, { endTime: now + waitTime });
    } else {
        waitTime = 10000;
        waitMessage = '✅ <b>تم فحص 100 رقم من أصل ' + totalNumbers + '</b>\n⚠️ تم تجاهل ' + (totalNumbers - MAX_CHECK) + ' رقم لأن الحد الأقصى 100 رقم لكل رسالة\n⏳ يمكنك الفحص مرة أخرى بعد 10 ثواني';
        userCooldowns.set(userId, { endTime: now + waitTime });
    }

    await ctx.replyWithHTML(waitMessage);

    let results = [];
    for (let i = 0; i < numbersToCheck.length; i++) {
        try {
            const [result] = await waClient.onWhatsApp(numbersToCheck[i]);
            const status = result?.exists ? '✅ مسجل' : '❌ غير مسجل';
            results.push('• ' + originalToCheck[i] + ': ' + status);
        } catch (error) {
            results.push('• ' + originalToCheck[i] + ': ⚠️ خطأ في الفحص');
        }
    }

    await ctx.replyWithHTML('📊 <b>نتيجة الفحص</b>\n\n' + results.join('\n'));
});

bot.launch().then(() => console.log('✅ البوت شغال!'));
process.once('SIGINT', () => bot.stop('SIGINT'));
process.once('SIGTERM', () => bot.stop('SIGTERM'));
EOF
